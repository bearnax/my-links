{% import "cards.njk" as cards -%}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }}</title>
    <link rel="stylesheet" href="style.css">
    <link rel="icon" type="image/x-icon" href="static/icons/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..900&display=swap" rel="stylesheet">
    {#
      The palette is settled before first paint so the page never flashes one
      colour and lands on another. Kept inline for that reason — index.js is a
      module and therefore deferred. A saved override from the footer picker
      wins; with none saved, one of the three flats is drawn at random.
    #}
    <script>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("{{ site.storagePrefix }}-theme"); } catch (e) {}
        if (!saved) {
          saved = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute("data-theme", saved);
      })();
    </script>
  </head>

  <body data-storage-prefix="{{ site.storagePrefix }}">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="wrap">
      <main id="main-content">

        <header class="page-header">
          <h1 class="brand">{{ site.brand | join("<br>") | safe }}</h1>
          <p class="brand-label">{{ site.tagline | join("<br>") | safe }}</p>
        </header>

        {% if links.favorites and links.favorites.length %}
        <section class="favorites-section" data-section aria-labelledby="favorites-heading">
          <h2 class="eyebrow" id="favorites-heading">Favorites</h2>
          <div class="favorites-row" id="favorites-row">
            {%- for fav in links.favorites %}{{ cards.favorite(fav) }}{% endfor -%}
          </div>
        </section>
        {% endif %}

        <div id="sections-container">
          {%- for sec in links.sections %}{{ cards.section(sec, loop.index) }}{% endfor -%}
        </div>

      </main>
    </div>

    <!-- Floating Bottom Bar (Search & Light/Dark Switch) -->
    <nav class="floating-dock" aria-label="Quick Actions">
      <button type="button" class="dock-btn neumo-btn" id="open-search-btn" aria-label="Search links" title="Search (Press /)">
        <span class="dock-icon" aria-hidden="true">⌕</span>
        <span class="dock-text">Search</span>
        <kbd class="dock-kbd" aria-hidden="true">/</kbd>
      </button>
      <button type="button" class="dock-btn neumo-btn" id="theme-toggle-btn" aria-label="Toggle light and dark mode" title="Toggle theme">
        <span class="theme-icon" aria-hidden="true">☀️</span>
        <span class="theme-text">Light</span>
      </button>
    </nav>

    <!-- Search Modal Popup -->
    <div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
      <div class="search-backdrop" id="search-backdrop"></div>
      <div class="search-dialog">
        <h2 id="search-modal-title" class="sr-only">Search Bookmarks</h2>
        <div class="search-input-wrapper">
          <span class="search-input-icon" aria-hidden="true">⌕</span>
          <input type="text" id="search-input" class="search-input" placeholder="Search links, keywords..." autocomplete="off" spellcheck="false">
          <button type="button" class="search-close-btn" id="close-search-btn" aria-label="Close search">
            <kbd aria-hidden="true">esc</kbd>
          </button>
        </div>
        <div class="search-results-container" id="search-results" role="listbox">
          <div class="search-empty-state">Type to search through all bookmarks...</div>
        </div>
      </div>
    </div>

    <script src="index.js" type="module"></script>
  </body>
</html>
