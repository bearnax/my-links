{% import "cards.njk" as cards -%}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Will's Links</title>
    <link rel="stylesheet" href="style.css">
    <link rel="icon" type="image/x-icon" href="static/icons/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..900&display=swap" rel="stylesheet">
    {#
      The palette is settled before first paint so the page never flashes one
      colour and lands on another. Kept inline for that reason — index.js is a
      module and therefore deferred. A saved override from the footer picker
      wins; with none saved, one of the three flats is drawn at random.
    #}
    <script>
      (function () {
        var random = ["blue", "green", "rust"];
        var all = random.concat(["velvet"]);
        var saved = null;
        try { saved = localStorage.getItem("wl-palette"); } catch (e) {}
        document.documentElement.setAttribute(
          "data-palette",
          all.indexOf(saved) !== -1
            ? saved
            : random[Math.floor(Math.random() * random.length)]);
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="wrap">
      <main id="main-content">

        <header class="page-header">
          <h1 class="brand">Will's<br>Links</h1>
          <p class="brand-label">Personal link<br>hub</p>
        </header>

        <section class="favorites-section" data-section aria-labelledby="favorites-heading">
          <h2 class="eyebrow" id="favorites-heading">Favorites</h2>
          <div class="favorites-row" id="favorites-row">
            {%- for fav in links.favorites %}{{ cards.favorite(fav) }}{% endfor -%}
          </div>
        </section>

        <div id="sections-container">
          {%- for sec in links.sections %}{{ cards.section(sec, loop.index) }}{% endfor -%}
        </div>

      </main>

      <footer class="page-footer">
        <p class="footer-label" id="palette-label">Style</p>
        <div class="palette-picker" id="palette-picker" role="group" aria-labelledby="palette-label">
          <button type="button" class="palette-btn" data-palette-choice="blue" aria-pressed="false"><span class="swatch swatch-blue" aria-hidden="true"></span>Blue</button>
          <button type="button" class="palette-btn" data-palette-choice="green" aria-pressed="false"><span class="swatch swatch-green" aria-hidden="true"></span>Green</button>
          <button type="button" class="palette-btn" data-palette-choice="rust" aria-pressed="false"><span class="swatch swatch-rust" aria-hidden="true"></span>Rust</button>
          <button type="button" class="palette-btn" data-palette-choice="velvet" aria-pressed="false"><span class="swatch swatch-velvet" aria-hidden="true"></span>Velvet</button>
          <button type="button" class="palette-btn" data-palette-choice="" aria-pressed="false">Shuffle each load</button>
        </div>
      </footer>
    </div>

    <script src="index.js" type="module"></script>
  </body>
</html>
