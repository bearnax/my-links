{% import "cards.njk" as cards -%}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Will's Links</title>
    <link rel="stylesheet" href="style.css">
    <link rel="icon" type="image/x-icon" href="static/icons/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..900&display=swap" rel="stylesheet">
    {#
      The palette is picked before first paint so the page never flashes one
      colour and settles on another. Kept inline for that reason — index.js is
      a module and therefore deferred.
    #}
    <script>
      (function () {
        var palettes = ["blue", "green", "rust"];
        document.documentElement.setAttribute(
          "data-palette", palettes[Math.floor(Math.random() * palettes.length)]);
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="wrap">
      <main id="main-content">

        <header class="page-header">
          <h1 class="brand">Will's<br>Links</h1>
          <p class="brand-label">Personal link<br>hub</p>
        </header>

        <section class="favorites-section" data-section aria-labelledby="favorites-heading">
          <h2 class="eyebrow" id="favorites-heading">Favorites</h2>
          <div class="favorites-row" id="favorites-row">
            {%- for fav in links.favorites %}{{ cards.favorite(fav) }}{% endfor -%}
          </div>
        </section>

        <div id="sections-container">
          {%- for sec in links.sections %}{{ cards.section(sec, loop.index) }}{% endfor -%}
        </div>

      </main>
    </div>

    <script src="index.js" type="module"></script>
  </body>
</html>
