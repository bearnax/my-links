{% import "cards.njk" as cards -%}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Will's Links</title>
    <link rel="stylesheet" href="style.css">
    <link rel="icon" type="image/x-icon" href="static/icons/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="wrap">
      <main id="main-content">

        <header class="page-header">
          <div class="brand">
            <h1>Will's Links</h1>
            <span class="brand-rule"></span>
            <span class="brand-label">Personal link hub</span>
          </div>

          <div class="header-tools">
            <div class="search-wrap">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><line x1="20" y1="20" x2="15.5" y2="15.5"></line></svg>
              <input type="search" id="link-search" class="search-input" placeholder="Find a link" aria-label="Find a link">
            </div>

            <div class="sections-wrap">
              <button type="button" class="ghost-btn" id="sections-toggle" aria-expanded="false" aria-controls="sections-menu">Sections</button>
              <nav class="sections-menu" id="sections-menu" aria-label="Jump to section" hidden>
                {%- for sec in links.sections %}<a href="#{{ sec.id }}">{{ sec.title }}</a>{% endfor -%}
              </nav>
            </div>

            <button type="button" class="ghost-btn ghost-btn--icon" id="theme-toggle" aria-label="Toggle light and dark">
              <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="5.2"></circle><line x1="12" y1="1.6" x2="12" y2="4"></line><line x1="12" y1="20" x2="12" y2="22.4"></line><line x1="1.6" y1="12" x2="4" y2="12"></line><line x1="20" y1="12" x2="22.4" y2="12"></line><line x1="4.6" y1="4.6" x2="6.3" y2="6.3"></line><line x1="17.7" y1="17.7" x2="19.4" y2="19.4"></line><line x1="4.6" y1="19.4" x2="6.3" y2="17.7"></line><line x1="17.7" y1="6.3" x2="19.4" y2="4.6"></line></svg>
            </button>
          </div>
        </header>

        <section class="favorites-section" data-section aria-labelledby="favorites-heading">
          <h2 class="eyebrow" id="favorites-heading">Favorites</h2>
          <div class="favorites-row" id="favorites-row">
            {%- for fav in links.favorites %}{{ cards.favorite(fav) }}{% endfor -%}
          </div>
        </section>

        <div id="sections-container">
          {%- for sec in links.sections %}{{ cards.section(sec, loop.index) }}{% endfor -%}
        </div>

        <p class="empty-state" id="empty-state" hidden>Nothing here by that name.</p>

      </main>
    </div>

    <script src="index.js" type="module"></script>
  </body>
</html>
