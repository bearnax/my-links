{#
  One macro per card type. Sections no longer declare a type — each item
  carries its own and `section` dispatches on it, so a section can mix a
  project and a person.

  The macros deliberately emit no whitespace between elements: several of the
  containers are flex, and the rendered DOM is diffed against previous output
  to keep template changes honest.
#}

{% macro favorite(fav) -%}
<a class="favorite-link" href="{{ fav.url }}" data-search="{{ fav | searchTerms }}"><img src="{{ fav.url | faviconUrl }}" alt="">{{ fav.label }}</a>
{%- endmacro %}

{% macro linkRow(link) -%}
<a class="row-link" href="{{ link.url }}" data-search="{{ link | searchTerms }}"><img src="{{ link.url | faviconUrl }}" alt=""><span class="row-label">{{ link.label }}</span><span class="row-arrow">↗</span></a>
{%- endmacro %}

{#
  Person and project share the card frame: a name, an optional note, and a
  row of labelled links. Only the middle differs — a project also carries a
  status dot. Keeping one frame means the CSS stays shared.

  A link labelled "Live" keeps the accent treatment it had when Live and Repo
  were fixed columns. Everything else renders plain, so an arbitrary resource
  does not quietly claim the emphasis meant for a deployed site.
#}
{% macro cardLinks(links) -%}
<div class="project-links">{% for link in links %}<a class="pl{% if link.label == "Live" %} pl-live{% endif %}" href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div>
{%- endmacro %}

{% macro person(p) -%}
<div class="person" data-search="{{ p | searchTerms }}"><div class="project-info"><span class="project-name">{{ p.name }}{% if p.note %} <span class="project-note">{{ p.note }}</span>{% endif %}</span></div>{{ cardLinks(p.links) }}</div>
{%- endmacro %}

{% macro project(p) -%}
<div class="project" data-search="{{ p | searchTerms }}"><div class="project-info"><span class="project-name">{% if p.emoji %}{{ p.emoji }} {% endif %}{{ p.name }}{% if p.note %} <span class="project-note">{{ p.note }}</span>{% endif %}</span><span class="project-status"><span class="dot dot-{{ p.status }}"></span>{{ p.statusLabel }}</span></div>{{ cardLinks(p.links) }}</div>
{%- endmacro %}

{% macro item(it) -%}
{% if it.type == "project" %}{{ project(it) }}{% elif it.type == "person" %}{{ person(it) }}{% else %}{{ linkRow(it) }}{% endif %}
{%- endmacro %}

{#
  A section's list class follows what is actually in it: a list of plain link
  rows is tighter than one of cards. Mixed sections get the card spacing,
  which is the more forgiving of the two.
#}
{% macro section(sec, index) -%}
{% set isLinkList = sec.items | isLinkList -%}
<details id="{{ sec.id }}" class="section-panel" data-section="" data-num="{{ index | sectionNumber }}"{% if sec.open %} open=""{% endif %}><summary><span class="sec-num">{{ index | sectionNumber }}</span><span class="sec-title">{{ sec.title }}</span><span class="sec-rule"></span><span class="sec-count">{{ sec.items | length }} link{% if sec.items | length != 1 %}s{% endif %}</span><span class="sec-glyph"></span></summary><div class="{{ "link-list" if isLinkList else "project-list" }}">{% for it in sec.items %}{{ item(it) }}{% endfor %}</div></details>
{%- endmacro %}
