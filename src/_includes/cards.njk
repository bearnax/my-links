{% macro arrow(className="pill-arrow") -%}
<span class="{{ className }}" aria-hidden="true">↗</span>
{%- endmacro %}

{% macro favorite(fav) -%}
<a class="favorite-btn neumo-btn" href="{{ fav.url }}" data-item-id="{{ fav.id or '' }}" data-search="{{ fav | searchTerms }}" target="_blank" rel="noopener noreferrer">
  {% if fav.icon %}
    <img class="fav-icon" src="{{ fav.icon }}" alt="" width="16" height="16">
  {% else %}
    <span class="fav-dot" aria-hidden="true"></span>
  {% endif %}
  <span class="fav-label">{{ fav.label }}</span>
  {{ arrow("btn-arrow") }}
</a>
{%- endmacro %}

{% macro action(url, label, kind="secondary") -%}
<a class="pill-btn {{ kind }}-pill" href="{{ url }}" target="_blank" rel="noopener noreferrer">
  <span class="pill-label">{{ label }}</span>{{ arrow() }}
</a>
{%- endmacro %}

{% macro item(it) -%}
{% set featured = it.presentation == "featured" %}
{% set singleDestination = not featured and it.primaryUrl and not it.links %}
{% set label = it.primaryUrlLabel if it.primaryUrlLabel and it.primaryUrlLabel != it.title else "" %}
<div class="item-card{% if featured %} featured-card{% if it.imageUrl %} has-image{% endif %}{% endif %}" data-item-id="{{ it.id or '' }}" data-search="{{ it | searchTerms }}">
  {% if featured and it.imageUrl %}
    <img class="project-image" src="{{ it.imageUrl }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">
  {% endif %}
  <div class="item-row-content">
    {% if singleDestination %}
      <a class="bookmark-link" href="{{ it.primaryUrl }}" target="_blank" rel="noopener noreferrer">
        <span><span class="item-title">{{ it.title }}</span>{% if label %}<span class="bookmark-label">{{ label }}</span>{% endif %}</span>
        {{ arrow() }}
      </a>
    {% else %}
      <p class="item-title">{{ it.title }}</p>
    {% endif %}
    {% if it.description %}<p class="item-description">{{ it.description }}</p>{% endif %}
    {% if not singleDestination %}
      <div class="item-links-inline">
        {% if it.primaryUrl %}{{ action(it.primaryUrl, label or ("Open project" if featured else "Open"), "primary") }}{% endif %}
        {% for link in it.links %}{{ action(link.url, link.label) }}{% endfor %}
      </div>
    {% endif %}
  </div>
</div>
{%- endmacro %}

{% macro section(sec) -%}
<details id="{{ sec.id }}" class="section-panel"{% if sec.accentHex %} style="--section-accent: {{ sec.accentHex }};"{% endif %}{% if sec.open %} open{% endif %}>
  <summary class="section-summary">
    <span class="sec-accent-pill" aria-hidden="true"></span>
    <span class="summary-copy">
      <span class="sec-title">{{ sec.title }}</span>
      {% if sec.subtitle %}<span class="sec-subtitle">{{ sec.subtitle }}</span>{% endif %}
    </span>
    <span class="sec-glyph-well" aria-hidden="true"><span class="sec-glyph"></span></span>
  </summary>
  <div class="items-list">
    {% for it in sec.items %}{{ item(it) }}{% endfor %}
  </div>
</details>
{%- endmacro %}
