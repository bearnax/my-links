{#
  Unified macros for the reclaimed links system.
  Stripped of all vanity terminology (projects, people, status dots, notes).
  Fast, clean, brutally efficient link navigation.
#}

{% macro favorite(fav) -%}
<a class="favorite-link" href="{{ fav.url }}" data-search="{{ fav | searchTerms }}">{{ fav.label }}</a>
{%- endmacro %}

{% macro item(it) -%}
<div class="item-row" data-search="{{ it | searchTerms }}"><div class="item-main">{% if it.primaryUrl %}<a class="item-title-link" href="{{ it.primaryUrl }}"><span class="item-title">{{ it.title }}</span><span class="item-title-arrow">↗</span></a>{% else %}<span class="item-title">{{ it.title }}</span>{% endif %}</div>{% if (it.primaryUrl and it.primaryUrlLabel and it.primaryUrlLabel != it.title) or (it.links and it.links.length > 0) %}<div class="item-links">{% if it.primaryUrl and it.primaryUrlLabel and it.primaryUrlLabel != it.title %}<a class="link-btn" href="{{ it.primaryUrl }}">{{ it.primaryUrlLabel }}</a>{% endif %}{% for link in it.links %}<a class="link-btn" href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div>{% endif %}</div>
{%- endmacro %}

{% macro section(sec, index) -%}
<details id="{{ sec.id }}" class="section-panel"{% if sec.accentName %} data-accent="{{ sec.accentName }}"{% endif %}{% if sec.accentHex %} style="--section-accent: {{ sec.accentHex }};"{% endif %} data-section="" data-num="{{ index | sectionNumber }}"{% if sec.open %} open=""{% endif %}><summary><span class="sec-glyph" aria-hidden="true"></span><span class="sec-num">{{ index | sectionNumber }}</span><span class="sec-title">{{ sec.title }}</span></summary><div class="items-list">{% for it in sec.items %}{{ item(it) }}{% endfor %}</div></details>
{%- endmacro %}

